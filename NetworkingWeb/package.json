{
  "name": "@knowyou/networking-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/require-supabase-env.mjs development && next dev",
    "start": "next start",
    "build": "node scripts/require-supabase-env.mjs production && next build",
    "preview:cloudflare": "node scripts/require-supabase-env.mjs production && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:production": "node scripts/require-supabase-env.mjs production && next build",
    "deploy:cloudflare": "node scripts/require-supabase-env.mjs production && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "e2e:networking": "playwright test tests/e2e/networking-agent-lab.spec.ts --project=chromium",
    "e2e:destinations": "playwright test tests/e2e/networking-destinations.spec.ts --project=chromium",
    "test:integration:device-revocation": "test -n \"$SUPABASE_DB_URL\" && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f tests/integration/networking-device-revocation.sql",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.106.2",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@opennextjs/cloudflare": "1.20.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/node": "25.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "comment-json": "4.6.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "typescript": "5.9.3",
    "vitest": "4.1.7",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
